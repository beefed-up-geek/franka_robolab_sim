#usda 1.0
(
    doc = """컨베이어 pick-and-place 씬.

    좌표 규약 — 테이블 상판 z=0, 로봇 베이스가 원점, 지면 z=-0.697.
    작업면: 좌우(Y) 160cm x 앞뒤(X) 150cm.

    컨베이어는 Z 축으로 90도 돌려서 길이(800)가 월드 Y 를 향하게 놓았다.
    로봇 앞 X=0.52 에 서고, Y -0.40 -> +0.40 방향으로 블록을 실어 나른다.
    반송면 높이는 테이블 위 0.20 이다.

    블록 6개는 벨트 위에 일정 간격으로 놓인다. 출구를 지나면
    franka_teleop/conveyor.py 가 입구로 되돌려 계속 흐르게 한다.

    payload 경로는 모두 이 저장소 안(../objects, ../conveyor)을 가리킨다.
    예전처럼 robolab 마운트 위치에 기대지 않는다.
    """
    defaultPrim = "world"
    endTimeCode = 0
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = -1
    upAxis = "Z"
)

def Xform "world"
{
    quatf xformOp:orient = (1, 0, 0, 0)
    float3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def Scope "Looks"
    {
        def Material "White_Matte"
        {
            token outputs:mdl:displacement.connect = </world/Looks/White_Matte/Shader.outputs:out>
            token outputs:mdl:surface.connect = </world/Looks/White_Matte/Shader.outputs:out>
            token outputs:mdl:volume.connect = </world/Looks/White_Matte/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.93, 0.93, 0.94)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.45
                float inputs:specular_level = 0.4
                token outputs:out (renderType = "material")
            }
        }

        def Material "BlockRed"
        {
            token outputs:mdl:displacement.connect = </world/Looks/BlockRed/Shader.outputs:out>
            token outputs:mdl:surface.connect = </world/Looks/BlockRed/Shader.outputs:out>
            token outputs:mdl:volume.connect = </world/Looks/BlockRed/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.78, 0.2, 0.16)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.42
                token outputs:out (renderType = "material")
            }
        }

        def Material "BlockAmber"
        {
            token outputs:mdl:displacement.connect = </world/Looks/BlockAmber/Shader.outputs:out>
            token outputs:mdl:surface.connect = </world/Looks/BlockAmber/Shader.outputs:out>
            token outputs:mdl:volume.connect = </world/Looks/BlockAmber/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.9, 0.62, 0.13)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.42
                token outputs:out (renderType = "material")
            }
        }

        def Material "BlockGreen"
        {
            token outputs:mdl:displacement.connect = </world/Looks/BlockGreen/Shader.outputs:out>
            token outputs:mdl:surface.connect = </world/Looks/BlockGreen/Shader.outputs:out>
            token outputs:mdl:volume.connect = </world/Looks/BlockGreen/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.3, 0.6, 0.36)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.42
                token outputs:out (renderType = "material")
            }
        }

        def Material "BlockBlue"
        {
            token outputs:mdl:displacement.connect = </world/Looks/BlockBlue/Shader.outputs:out>
            token outputs:mdl:surface.connect = </world/Looks/BlockBlue/Shader.outputs:out>
            token outputs:mdl:volume.connect = </world/Looks/BlockBlue/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.22, 0.45, 0.72)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.42
                token outputs:out (renderType = "material")
            }
        }

        def Material "BlockPurple"
        {
            token outputs:mdl:displacement.connect = </world/Looks/BlockPurple/Shader.outputs:out>
            token outputs:mdl:surface.connect = </world/Looks/BlockPurple/Shader.outputs:out>
            token outputs:mdl:volume.connect = </world/Looks/BlockPurple/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.52, 0.3, 0.62)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.42
                token outputs:out (renderType = "material")
            }
        }

        def Material "BlockTeal"
        {
            token outputs:mdl:displacement.connect = </world/Looks/BlockTeal/Shader.outputs:out>
            token outputs:mdl:surface.connect = </world/Looks/BlockTeal/Shader.outputs:out>
            token outputs:mdl:volume.connect = </world/Looks/BlockTeal/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.15, 0.58, 0.6)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.42
                token outputs:out (renderType = "material")
            }
        }
    }

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.9
        float physics:staticFriction = 1.1
        float physics:restitution = 0
        uniform token physxMaterial:frictionCombineMode = "max"
    }

    # -- 흰색 작업대 -----------------------------------------------------
    # 프림 이름은 반드시 "table" 이어야 한다 (RoboLab 접촉 센서 규약).
    # 상판: x [-0.45, 1.05] 150cm, y [-0.80, 0.80] 160cm, z [-0.05, 0]
    def Cube "table" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 2
        float3 xformOp:scale = (0.75, 0.8, 0.025)
        double3 xformOp:translate = (0.3, 0, -0.025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </world/Looks/White_Matte> (
            bindMaterialAs = "strongerThanDescendants"
        )
        rel material:binding:physics = </world/PhysicsMaterial>
    }

    def Xform "table_legs"
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Cube "LegFrontLeft" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            float3 xformOp:scale = (0.035, 0.035, 0.3235)
            double3 xformOp:translate = (0.95, 0.7, -0.3735)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </world/Looks/White_Matte> (bindMaterialAs = "strongerThanDescendants")
        }
        def Cube "LegFrontRight" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            float3 xformOp:scale = (0.035, 0.035, 0.3235)
            double3 xformOp:translate = (0.95, -0.7, -0.3735)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </world/Looks/White_Matte> (bindMaterialAs = "strongerThanDescendants")
        }
        def Cube "LegBackLeft" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            float3 xformOp:scale = (0.035, 0.035, 0.3235)
            double3 xformOp:translate = (-0.35, 0.7, -0.3735)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </world/Looks/White_Matte> (bindMaterialAs = "strongerThanDescendants")
        }
        def Cube "LegBackRight" (prepend apiSchemas = ["MaterialBindingAPI"])
        {
            double size = 2
            float3 xformOp:scale = (0.035, 0.035, 0.3235)
            double3 xformOp:translate = (-0.35, -0.7, -0.3735)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </world/Looks/White_Matte> (bindMaterialAs = "strongerThanDescendants")
        }
    }

    def Xform "GroundPlane"
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, -0.697)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Plane "CollisionPlane" (prepend apiSchemas = ["PhysicsCollisionAPI"])
        {
            uniform token axis = "Z"
            uniform token purpose = "guide"
        }
    }

    # 컨베이어는 여기서 payload 로 붙이지 않는다. RoboLab 이 씬 USD 를 통째로
    # AssetBaseCfg 로 스폰하는데, **payload 안의 콜라이더는 PhysX 에 등록되지
    # 않아** 블록이 그대로 통과했다 (정적/키네마틱 모두 실패, 인라인 콜라이더만
    # 동작). 그래서 컨베이어는 franka_teleop/world_assets.py 에서 별도 씬
    # 엔티티로 스폰한다 — 배치 좌표도 그쪽에 있다.

    # -- 담을 그릇 -------------------------------------------------------
    def "bowl" (
        prepend payload = @../objects/bowl.usd@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.35, 0.52, 0.031)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    # 블록이 아닌 물체도 벨트에 실리는지 확인하기 위한 원기둥.
    # 이름이 block_ 으로 시작하지 않으므로 순환(회수) 대상이 아니고, 오직
    # "벨트에 얹혀 있으면 실린다" 규칙만으로 움직여야 한다.
    def Cylinder "can_a" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    )
    {
        uniform token axis = "Z"
        double radius = 0.022
        double height = 0.055
        float physics:mass = 0.06
        float physxRigidBody:sleepThreshold = 0
        double3 xformOp:translate = (0.52, -0.30, 0.2285)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </world/Looks/BlockAmber> (
            bindMaterialAs = "strongerThanDescendants"
        )
        rel material:binding:physics = </world/PhysicsMaterial>
    }

    # -- 벨트 위 블록 45mm -----------------------------------------------
    def Cube "block_0" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    )
    {
        double size = 2
        float physics:mass = 0.05
        # 벨트 위에 가만히 얹혀 있으면 PhysX 가 이 강체를 sleep 시켜 버리고,
        # 그러면 매 스텝 써 주는 반송 속도가 통째로 무시된다(실제로 vy 가 계속
        # 0 으로 나왔다). 잠들지 않게 문턱값을 0 으로 둔다.
        float physxRigidBody:sleepThreshold = 0
        float physxRigidBody:stabilizationThreshold = 0
        float3 xformOp:scale = (0.0225, 0.0225, 0.0225)
        double3 xformOp:translate = (0.52, -0.36, 0.2235)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </world/Looks/BlockRed> (
            bindMaterialAs = "strongerThanDescendants"
        )
        rel material:binding:physics = </world/PhysicsMaterial>
    }

    def Cube "block_1" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    )
    {
        double size = 2
        float physics:mass = 0.05
        # 벨트 위에 가만히 얹혀 있으면 PhysX 가 이 강체를 sleep 시켜 버리고,
        # 그러면 매 스텝 써 주는 반송 속도가 통째로 무시된다(실제로 vy 가 계속
        # 0 으로 나왔다). 잠들지 않게 문턱값을 0 으로 둔다.
        float physxRigidBody:sleepThreshold = 0
        float physxRigidBody:stabilizationThreshold = 0
        float3 xformOp:scale = (0.0225, 0.0225, 0.0225)
        double3 xformOp:translate = (0.52, -0.24, 0.2235)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </world/Looks/BlockAmber> (
            bindMaterialAs = "strongerThanDescendants"
        )
        rel material:binding:physics = </world/PhysicsMaterial>
    }

    def Cube "block_2" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    )
    {
        double size = 2
        float physics:mass = 0.05
        # 벨트 위에 가만히 얹혀 있으면 PhysX 가 이 강체를 sleep 시켜 버리고,
        # 그러면 매 스텝 써 주는 반송 속도가 통째로 무시된다(실제로 vy 가 계속
        # 0 으로 나왔다). 잠들지 않게 문턱값을 0 으로 둔다.
        float physxRigidBody:sleepThreshold = 0
        float physxRigidBody:stabilizationThreshold = 0
        float3 xformOp:scale = (0.0225, 0.0225, 0.0225)
        double3 xformOp:translate = (0.52, -0.12, 0.2235)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </world/Looks/BlockGreen> (
            bindMaterialAs = "strongerThanDescendants"
        )
        rel material:binding:physics = </world/PhysicsMaterial>
    }

    def Cube "block_3" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    )
    {
        double size = 2
        float physics:mass = 0.05
        # 벨트 위에 가만히 얹혀 있으면 PhysX 가 이 강체를 sleep 시켜 버리고,
        # 그러면 매 스텝 써 주는 반송 속도가 통째로 무시된다(실제로 vy 가 계속
        # 0 으로 나왔다). 잠들지 않게 문턱값을 0 으로 둔다.
        float physxRigidBody:sleepThreshold = 0
        float physxRigidBody:stabilizationThreshold = 0
        float3 xformOp:scale = (0.0225, 0.0225, 0.0225)
        double3 xformOp:translate = (0.52, 0.0, 0.2235)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </world/Looks/BlockBlue> (
            bindMaterialAs = "strongerThanDescendants"
        )
        rel material:binding:physics = </world/PhysicsMaterial>
    }

    def Cube "block_4" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    )
    {
        double size = 2
        float physics:mass = 0.05
        # 벨트 위에 가만히 얹혀 있으면 PhysX 가 이 강체를 sleep 시켜 버리고,
        # 그러면 매 스텝 써 주는 반송 속도가 통째로 무시된다(실제로 vy 가 계속
        # 0 으로 나왔다). 잠들지 않게 문턱값을 0 으로 둔다.
        float physxRigidBody:sleepThreshold = 0
        float physxRigidBody:stabilizationThreshold = 0
        float3 xformOp:scale = (0.0225, 0.0225, 0.0225)
        double3 xformOp:translate = (0.52, 0.12, 0.2235)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </world/Looks/BlockPurple> (
            bindMaterialAs = "strongerThanDescendants"
        )
        rel material:binding:physics = </world/PhysicsMaterial>
    }

    def Cube "block_5" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    )
    {
        double size = 2
        float physics:mass = 0.05
        # 벨트 위에 가만히 얹혀 있으면 PhysX 가 이 강체를 sleep 시켜 버리고,
        # 그러면 매 스텝 써 주는 반송 속도가 통째로 무시된다(실제로 vy 가 계속
        # 0 으로 나왔다). 잠들지 않게 문턱값을 0 으로 둔다.
        float physxRigidBody:sleepThreshold = 0
        float physxRigidBody:stabilizationThreshold = 0
        float3 xformOp:scale = (0.0225, 0.0225, 0.0225)
        double3 xformOp:translate = (0.52, 0.24, 0.2235)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </world/Looks/BlockTeal> (
            bindMaterialAs = "strongerThanDescendants"
        )
        rel material:binding:physics = </world/PhysicsMaterial>
    }
}
