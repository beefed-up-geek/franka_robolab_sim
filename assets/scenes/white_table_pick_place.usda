#usda 1.0
(
    doc = """흰색 테이블 위 pick-and-place 씬.

    RoboLab 규약을 따른다 — 테이블 상판이 z=0, 로봇 베이스가 원점, 지면은 z=-0.697.
    상판은 RoboLab 의 나무 테이블(table_oak/franka_table) 대신 흰색 Cube 로 직접
    깔았다. payload 로 들어오는 USD 는 내부 프림이 자기 머티리얼을 들고 있어서
    바깥에서 흰색으로 덮어쓰기가 불안정하기 때문이다.

    payload 경로는 이 파일 기준 상대경로로, /workspace 아래에 robolab 과
    franka_robolab_sim 이 나란히 마운트되어 있다고 가정한다 (scripts/container_up.sh).
    """
    defaultPrim = "world"
    endTimeCode = 0
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = -1
    upAxis = "Z"
)

def Xform "world"
{
    quatf xformOp:orient = (1, 0, 0, 0)
    float3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def Scope "Looks"
    {
        def Material "White_Matte"
        {
            token outputs:mdl:displacement.connect = </world/Looks/White_Matte/Shader.outputs:out>
            token outputs:mdl:surface.connect = </world/Looks/White_Matte/Shader.outputs:out>
            token outputs:mdl:volume.connect = </world/Looks/White_Matte/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                # OmniPBR 은 Kit 내장 MDL 이라 에셋 경로 해석에 의존하지 않는다.
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.93, 0.93, 0.94) (
                    displayGroup = "Albedo"
                )
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.45
                float inputs:specular_level = 0.4
                token outputs:out (
                    renderType = "material"
                )
            }
        }
    }

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 2
        float physics:staticFriction = 2
        uniform token physxMaterial:frictionCombineMode = "max"
    }

    # ── 흰색 테이블 ──────────────────────────────────────────────────────
    # Cube 는 size=2 (반변 1) 기준이므로 scale 이 곧 반변 길이가 된다.
    #
    # 상판 프림의 이름은 반드시 "table" 이어야 한다. RoboLab 의 pick_and_place
    # 서브태스크가 gripper_hit_table 프레디킷에서 "table" 이라는 이름으로 접촉
    # 센서(gripper__table)를 찾기 때문이다. 그래서 Xform 으로 감싸지 않고
    # 콜라이더 Cube 자체를 table 로 둔다.
    #
    # 상판: x∈[-0.45, 1.05], y∈[-0.65, 0.65], z∈[-0.05, 0]
    def Cube "table" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        double size = 2
        float3 xformOp:scale = (0.75, 0.65, 0.025)
        double3 xformOp:translate = (0.3, 0, -0.025)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </world/Looks/White_Matte> (
            bindMaterialAs = "strongerThanDescendants"
        )
        rel material:binding:physics = </world/PhysicsMaterial>
    }

    # 다리 4개 — 순수 장식. 상판 아래 z∈[-0.697, -0.05] 이라 로봇이 닿지 않으므로
    # 콜리전도 접촉 센서도 붙이지 않는다.
    def Xform "table_legs"
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Cube "LegFrontLeft" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 2
            float3 xformOp:scale = (0.035, 0.035, 0.3235)
            double3 xformOp:translate = (0.95, 0.55, -0.3735)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </world/Looks/White_Matte> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }

        def Cube "LegFrontRight" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 2
            float3 xformOp:scale = (0.035, 0.035, 0.3235)
            double3 xformOp:translate = (0.95, -0.55, -0.3735)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </world/Looks/White_Matte> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }

        def Cube "LegBackLeft" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 2
            float3 xformOp:scale = (0.035, 0.035, 0.3235)
            double3 xformOp:translate = (-0.35, 0.55, -0.3735)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </world/Looks/White_Matte> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }

        def Cube "LegBackRight" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            double size = 2
            float3 xformOp:scale = (0.035, 0.035, 0.3235)
            double3 xformOp:translate = (-0.35, -0.55, -0.3735)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </world/Looks/White_Matte> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }
    }

    def Xform "GroundPlane"
    {
        token visibility = "invisible"
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, -0.697)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Plane "CollisionPlane" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            uniform token purpose = "guide"
        }
    }

    # ── 조작 대상 ────────────────────────────────────────────────────────
    def "banana" (
        prepend payload = @../../../robolab/assets/objects/ycb/banana.usd@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.5, -0.14, 0.022)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "bowl" (
        prepend payload = @../../../robolab/assets/objects/ycb/bowl.usd@
    )
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.56, 0.16, 0.031)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}
