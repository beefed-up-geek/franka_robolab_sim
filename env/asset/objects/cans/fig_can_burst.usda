#usda 1.0
(
    "fig_can 을 tools/burst_from_usd.py 로 변형한 파열품. 원본 텍스처·UV 를 그대로 쓴다. 형상을 바꾸려면 이 파일이 아니라 생성기를 고쳐 다시 만들 것."
    defaultPrim = "fig_can_burst"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "fig_can_burst" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.4

    def Scope "Looks"
    {
        def Material "CanLabel"
        {
            token outputs:mdl:displacement.connect = </fig_can_burst/Looks/CanLabel/Shader.outputs:out>
            token outputs:mdl:surface.connect = </fig_can_burst/Looks/CanLabel/Shader.outputs:out>
            token outputs:mdl:volume.connect = </fig_can_burst/Looks/CanLabel/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.055, 0.231, 0.361)
                asset inputs:diffuse_texture = @textures/fig_can_label.png@ (
                    colorSpace = "sRGB"
                )
                float inputs:metallic_constant = 0.05
                float inputs:reflection_roughness_constant = 0.52
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "TornEdge"
        {
            token outputs:mdl:displacement.connect = </fig_can_burst/Looks/TornEdge/Shader.outputs:out>
            token outputs:mdl:surface.connect = </fig_can_burst/Looks/TornEdge/Shader.outputs:out>
            token outputs:mdl:volume.connect = </fig_can_burst/Looks/TornEdge/Shader.outputs:out>

