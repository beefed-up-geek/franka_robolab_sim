#usda 1.0
(
    doc = """VALLE DORADO HIGOS — 파열품.

    normal_can/burst_can 과 **치수·질량·충돌 형상이 완전히 같다.** 라벨 도안만
    다르다 (tools/can_designs.py). 정책이 캔 종류에 따라 다르게 잡을 이유가
    없어야 하므로, 종류를 늘릴 때 물성은 건드리지 않는다.

    짝은 fig_can 다. 둘은 같은 라벨 이미지를 쓴다 — 파열품만 라벨이 다르면
    정책이 결함이 아니라 그림을 외워서 골라내게 된다.

    이 파일은 tools/make_cans.py 가 생성한다. 형상을 바꾸려면 USDA 를 직접 고치지
    말고 생성기를 고쳐서 두 캔을 함께 다시 만들 것 — 짝이 어긋나면 대조군의
    의미가 없어진다.

    원점은 바운딩박스 중심이다. franka_env/conveyor.py 가 물체의 반높이를 재서
    "벨트에 얹힌 높이"를 계산하는데 그 계산이 원점=중심을 전제한다.
    """
    defaultPrim = "fig_can_burst"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "fig_can_burst" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.4

    def Scope "Looks"
    {
        def Material "Steel"
        {
            token outputs:mdl:displacement.connect = </fig_can_burst/Looks/Steel/Shader.outputs:out>
            token outputs:mdl:surface.connect = </fig_can_burst/Looks/Steel/Shader.outputs:out>
            token outputs:mdl:volume.connect = </fig_can_burst/Looks/Steel/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.7, 0.71, 0.73)
                float inputs:metallic_constant = 0.88
                float inputs:reflection_roughness_constant = 0.3
                token outputs:out (renderType = "material")
            }
        }

        def Material "CanLabel"
        {
            token outputs:mdl:displacement.connect = </fig_can_burst/Looks/CanLabel/Shader.outputs:out>
            token outputs:mdl:surface.connect = </fig_can_burst/Looks/CanLabel/Shader.outputs:out>
            token outputs:mdl:volume.connect = </fig_can_burst/Looks/CanLabel/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.243, 0.122, 0.302)
                asset inputs:diffuse_texture = @./textures/fig_can_label.png@ (
                    colorSpace = "sRGB"
                )
                float inputs:metallic_constant = 0.05
                float inputs:reflection_roughness_constant = 0.52
                token outputs:out (renderType = "material")
            }
        }

        def Material "TornEdge"
        {
            token outputs:mdl:displacement.connect = </fig_can_burst/Looks/TornEdge/Shader.outputs:out>
            token outputs:mdl:surface.connect = </fig_can_burst/Looks/TornEdge/Shader.outputs:out>
            token outputs:mdl:volume.connect = </fig_can_burst/Looks/TornEdge/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.8, 0.81, 0.83)
                float inputs:metallic_constant = 0.92
                float inputs:reflection_roughness_constant = 0.22
                token outputs:out (renderType = "material")
            }
        }

        def Material "Contents"
        {
            token outputs:mdl:displacement.connect = </fig_can_burst/Looks/Contents/Shader.outputs:out>
            token outputs:mdl:surface.connect = </fig_can_burst/Looks/Contents/Shader.outputs:out>
            token outputs:mdl:volume.connect = </fig_can_burst/Looks/Contents/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.4, 0.26, 0.12)
                float inputs:metallic_constant = 0.0
                float inputs:reflection_roughness_constant = 0.88
                token outputs:out (renderType = "material")
            }
        }

        def Material "RimBand"
        {
            token outputs:mdl:displacement.connect = </fig_can_burst/Looks/RimBand/Shader.outputs:out>
            token outputs:mdl:surface.connect = </fig_can_burst/Looks/RimBand/Shader.outputs:out>
            token outputs:mdl:volume.connect = </fig_can_burst/Looks/RimBand/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.0, 0.9, 0.2)
                float inputs:metallic_constant = 0.0
                float inputs:reflection_roughness_constant = 0.45
                token outputs:out (renderType = "material")
            }
        }
    }

    def Mesh "shell" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4