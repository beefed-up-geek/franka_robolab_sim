#usda 1.0
(
    doc = """task3 학습/평가 환경이 공유하는 고정 설비 — 작업대·다리·지면·재질.

    좌표 규약 — 테이블 상판 z=0, 로봇 베이스가 원점, 지면 z=-0.697.
    작업면: 좌우(Y) 160cm x 앞뒤(X) 150cm.

    캔은 여기 없다. 흐르는 물건만 다른 두 환경(task3_train / task3_test)이
    이 파일을 서브레이어로 얹어 쓴다. 복사해 두면 한쪽만 고쳐져 두 환경이
    조용히 달라지고, 그러면 평가 결과가 환경 차이 탓인지 정책 탓인지
    구분할 수 없게 된다.

    컨베이어와 담을 통(grey_bin)은 이 파일에 없다. RoboLab 이 씬 USD 를 통째로
    스폰할 때 payload 안의 정적 콜라이더가 PhysX 에 등록되지 않는 문제가 있어,
    둘 다 franka_env/world_assets.py 에서 별도 씬 엔티티로 스폰한다.
    """
    doc = """컨베이어 통조림 분류 씬.

    좌표 규약 — 테이블 상판 z=0, 로봇 베이스가 원점, 지면 z=-0.697.
    작업면: 좌우(Y) 160cm x 앞뒤(X) 150cm.

    통조림 4종이 벨트를 타고 흘러온다. 간격을 넓게 두려고 벨트에는 3개만 올리고,
    나머지 1개는 상판 아래에서 대기로 시작한다 — 출구를 지난 것이 대기열로 들어가고
    입구가 비면 하나씩 투입되므로, 결과적으로 4종이 돌아가며 흐른다
    (franka_env/conveyor.py 의 recycle 참고).

    종류마다 높이가 달라(33 / 58mm)
    파지 높이를 매번 맞춰야 하므로, 같은 크기 블록만 있을 때보다 시연 데이터가
    풍부해진다. 캔 원점은 **중심**이라 벨트에 얹으려면 반높이만큼 올려야 한다
    (아래 translate 의 z 값이 그렇게 계산된 것이다).

    컨베이어와 담을 통(grey_bin)은 이 파일에 없다. RoboLab 이 씬 USD 를 통째로
    스폰할 때 payload 안의 정적 콜라이더가 PhysX 에 등록되지 않는 문제가 있어,
    둘 다 franka_env/world_assets.py 에서 별도 씬 엔티티로 스폰한다.
    """
    defaultPrim = "world"
    endTimeCode = 0
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = -1
    upAxis = "Z"
)

def Xform "world"
{
    quatf xformOp:orient = (1, 0, 0, 0)
    float3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def Scope "Looks"
    {
        def Material "White_Matte"
        {
            token outputs:mdl:displacement.connect = </world/Looks/White_Matte/Shader.outputs:out>
            token outputs:mdl:surface.connect = </world/Looks/White_Matte/Shader.outputs:out>
            token outputs:mdl:volume.connect = </world/Looks/White_Matte/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.93, 0.93, 0.94)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.45
                float inputs:specular_level = 0.4
                token outputs:out (renderType = "material")
            }
        }

        def Material "Wood_Oak"
        {
            token outputs:mdl:displacement.connect = </world/Looks/Wood_Oak/Shader.outputs:out>
            token outputs:mdl:surface.connect = </world/Looks/Wood_Oak/Shader.outputs:out>
            token outputs:mdl:volume.connect = </world/Looks/Wood_Oak/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                asset inputs:diffuse_texture = @../textures/wood_oak_basecolor.png@ (
                    colorSpace = "sRGB"
                )
                bool inputs:project_uvw = 1
                bool inputs:world_or_object = 0
                float2 inputs:texture_scale = (1, 1)
                float inputs:reflection_roughness_constant = 0.5
                float inputs:specular_level = 0.2
                token outputs:out
            }
        }
    }

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.9
        float physics:staticFriction = 1.1
        float physics:restitution = 0
        uniform token physxMaterial:frictionCombineMode = "max"
    }

    # -- RoboLab 오크 테이블 ---------------------------------------------
    # 프림 이름은 반드시 "table" 이어야 한다 (RoboLab 접촉 센서 규약).
    # robolab assets/fixtures/table_oak.usd (오크 상판 3cm + 금속 원기둥 다리,
    # 충돌체 포함) 를 기존 흰 작업대와 같은 발자국(x -0.45..1.05, y ±0.8,
    # 상판 z=0, 바닥 -0.70)으로 스케일했다. 재질은 클라우드 vMaterials
    # (Oak·RustedMetal) — 첫 로드에 다운로드된다 (컨테이너 외부망 확인됨).
    def "table" (
        prepend references = @../../../../robolab/assets/fixtures/table_oak.usd@
    )
    {
        # 에셋 루트에 PhysicsRigidBodyAPI 가 켜져 있다(동적!) — 정적 콜라이더로
        # 끈다. 안 끄면 로봇이 누르는 힘에 책상째 밀린다.
        bool physics:rigidBodyEnabled = 0
        double3 xformOp:translate = (0.3, 0, -0.35)
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (2.142857, 1.6, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        rel material:binding:physics = </world/PhysicsMaterial> (
            bindMaterialAs = "strongerThanDescendants"
        )

        # 상판 콜라이더에 직접 바인딩 — 에셋이 top 에 자체 시각 재질을 갖고
        # 있어, 루트의 물리 바인딩만으로는 기본 저마찰로 풀린다 (실측:
        # 플러그가 파지 중 미끄러짐).
        over "table_01"
        {
            over "top"
            {
                rel material:binding:physics = </world/PhysicsMaterial>
            }
        }

        # Oak 렌더 재질에 물리 속성을 직접 얹는다 — 콜라이더가 자체 시각
        # 재질을 바인딩하고 있어 이 경로가 가장 확실하다 (RoboLab 원본에는
        # 물리 재질이 아예 없어 기본 마찰 0.5 로 풀린다, 실측).
        over "Looks"
        {
            over "Oak" (
                prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
            )
            {
                float physics:staticFriction = 1.1
                float physics:dynamicFriction = 0.9
                float physics:restitution = 0
                uniform token physxMaterial:frictionCombineMode = "max"
            }
        }
    }


    def Xform "GroundPlane"
    {
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, -0.697)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Plane "CollisionPlane" (prepend apiSchemas = ["PhysicsCollisionAPI"])
        {
            uniform token axis = "Z"
            uniform token purpose = "guide"
        }
    }
}
