#usda 1.0
(
    doc = """task2 train 씬 — 발전기 DC 전선을 배터리 단자에 연결.

    고정 설비는 task1/task3 과 같은 _can_workcell.usda(작업대·바닥) 서브레이어.
    워크스페이스 매트도 task1 과 동일 (x 0.35~0.75, y -0.35~0.35, 3mm 콜라이더).

    배치 (기본 behind 뷰 기준 화면 오른쪽 = -y):
      배터리(SAM3D, H5 실측 0.242m, z180° 반전)  (0.36, -0.48)  — 발전기와 ~1.0m, 삽입자세 도달 0.75
      발전기(SAM3D, 장축 0.40m, z+90°)           (0.55, +0.50)  — 화면 왼쪽
      중심 간 거리 0.92m — 배터리는 Franka 도달권 안, 발전기는 밖(고정 소품).
    전선·플러그·안착 판정은 다음 단계에서 붙는다.
    """
    subLayers = [
        @./_can_workcell.usda@
    ]
    defaultPrim = "world"
    metersPerUnit = 1
    upAxis = "Z"
)

over "world"
{
    def Scope "Task2Looks"
    {
        def Material "MatWhite"
        {
            token outputs:mdl:displacement.connect = </world/Task2Looks/MatWhite/Shader.outputs:out>
            token outputs:mdl:surface.connect = </world/Task2Looks/MatWhite/Shader.outputs:out>
            token outputs:mdl:volume.connect = </world/Task2Looks/MatWhite/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.93, 0.93, 0.90)
                float inputs:reflection_roughness_constant = 0.6
                token outputs:out (renderType = "material")
            }
        }
    }

    # ── 흰색 워크스페이스 매트 — task1 과 동일 ──────────────────────────
    def Cube "workspace_mat" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </world/Task2Looks/MatWhite>
        double3 xformOp:translate = (0.55, 0.0, 0.0015)
        float3 xformOp:scale = (0.20, 0.35, 0.0015)
        quatf xformOp:orient = (1, 0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        double size = 2
    }

    # ── SAM3D 복원 기물 ────────────────────────────────────────────────
    # 배터리는 강체 — 씬에 강체가 하나도 없으면 접촉 센서 활성화가 실패하고
    # (robolab schemas 검사), 다음 단계의 단자 안착 판정에도 어차피 필요하다.
    def "battery" (
        prepend references = @../objects/task2/sam3d_battery.usda@
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 15.0
        quatf xformOp:orient = (0, 0, 0, 1)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.36, -0.48, 0.0005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "mesh" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
        }

        # 단자 연장 포스트 (실물의 terminal extender) — SAM3D 메시의 단자가
        # 리세스 속에 있어 소켓이 물리적으로 씌워질 수 없으므로, 단자 위치에
        # 단자 실측 중심에 황동색 연장 포스트(r9.5mm, 단자와 동색)를 세워 뚜껑 위 2cm 돌출시킨다. 부착 목표 = 이 상단.
        def Cylinder "post_ext_pos" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double radius = 0.0095
            double height = 0.05
            color3f[] primvars:displayColor = [(0.61, 0.54, 0.31)]
            double3 xformOp:translate = (0.0962, -0.0546, 0.185)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cylinder "post_ext_pos_ring" 
        {
            uniform token axis = "Z"
            double radius = 0.0095
            double height = 0.006
            color3f[] primvars:displayColor = [(0.8, 0.12, 0.09)]
            double3 xformOp:translate = (0.0962, -0.0546, 0.166)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cylinder "post_ext_neg" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double radius = 0.0095
            double height = 0.05
            color3f[] primvars:displayColor = [(0.61, 0.54, 0.31)]
            double3 xformOp:translate = (-0.0962, -0.0523, 0.185)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cylinder "post_ext_neg_ring"
        {
            uniform token axis = "Z"
            double radius = 0.0095
            double height = 0.006
            color3f[] primvars:displayColor = [(0.1, 0.25, 0.6)]
            double3 xformOp:translate = (-0.0962, -0.0523, 0.166)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
    def "generator" (
        prepend references = @../objects/task2/sam3d_generator.usda@
    )
    {
        quatf xformOp:orient = (0.7071068, 0, 0, 0.7071068)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.55, 0.5, 0.0005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }










    def Material "rope_phys_mat" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 0.05
        float physics:dynamicFriction = 0.05
        float physics:restitution = 0.0
    }
    # ── DC 충전 전선 — 물리 정착 곡선을 구운 **고정 튜브 메시** (시각 전용).
    #    소켓 면에서 나와 상판 위로만 늘어져 커넥터 인입부에 시각적으로 닿는다.
    #    커넥터를 옮겨도 전선은 남는다 (관절 로프는 혼란이 커 되돌림 — 사용자 결정).
    def Cylinder "dc_socket"
    {
        uniform token axis = "Y"
        double radius = 0.03
        double height = 0.05
        color3f[] primvars:displayColor = [(0.55, 0.56, 0.58)]
        double3 xformOp:translate = (0.5, 0.372, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cylinder "dc_socket_face"
    {
        uniform token axis = "Y"
        double radius = 0.022
        double height = 0.006
        color3f[] primvars:displayColor = [(0.35, 0.36, 0.38)]
        double3 xformOp:translate = (0.5, 0.3455, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Mesh "wire_red"
    {
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3