#usda 1.0
(
    doc = """task1 씬 — 공구 건네주기 (도면 v3).

    고정 설비는 task3 와 같은 _can_workcell.usda(작업대·바닥)를 서브레이어로 쓴다.
    컨베이어·통은 애초에 씬이 아니라 world_assets 스폰이므로 여기 없고, task1 은
    Task1HandoverWorldCfg 가 창고·작업자·손바닥 받침만 스폰한다.

    좌표 근거 (도면 v3):
      워크스페이스 매트  x 0.35~0.75, y -0.35~0.35, 상판 위 3mm (콜라이더 있음)
      작업자 구역        y -0.80~-0.40 — 면 전체를 옅은 사선으로 칠한다
      경계 테이프        y -0.425~-0.375 (50mm), 상판 전장 — 노랑/검정 사선
      공구 3점           x 0.55, y -0.20 / 0 / +0.20 (자세는 robolab
                         tools_sorting.usda 의 물리 안착값을 그대로 가져왔다)

    공구가 경계(y=-0.40)를 넘으면 초기 위치로 되돌리는 로직은 런타임(runner)
    쪽에 붙는다 — 씬은 경계의 시각 표기만 담당한다.
    """
    subLayers = [
        @./_can_workcell.usda@
    ]
    defaultPrim = "world"
    metersPerUnit = 1
    upAxis = "Z"
)

over "world"
{
    def Scope "Task1Looks"
    {
        def Material "MatGripBand"
        {
            token outputs:mdl:displacement.connect = </world/Task1Looks/MatGripBand/Shader.outputs:out>
            token outputs:mdl:surface.connect = </world/Task1Looks/MatGripBand/Shader.outputs:out>
            token outputs:mdl:volume.connect = </world/Task1Looks/MatGripBand/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.98, 0.82, 0.0)
                float inputs:reflection_roughness_constant = 0.45
                token outputs:out (renderType = "material")
            }
        }
        def Material "MatWhite"
        {
            token outputs:mdl:displacement.connect = </world/Task1Looks/MatWhite/Shader.outputs:out>
            token outputs:mdl:surface.connect = </world/Task1Looks/MatWhite/Shader.outputs:out>
            token outputs:mdl:volume.connect = </world/Task1Looks/MatWhite/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.93, 0.93, 0.90)
                float inputs:reflection_roughness_constant = 0.6
                token outputs:out (renderType = "material")
            }
        }
        def Material "MatTape"
        {
            token outputs:mdl:displacement.connect = </world/Task1Looks/MatTape/Shader.outputs:out>
            token outputs:mdl:surface.connect = </world/Task1Looks/MatTape/Shader.outputs:out>
            token outputs:mdl:volume.connect = </world/Task1Looks/MatTape/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.9, 0.76, 0.12)
                asset inputs:diffuse_texture = @/workspace/franka_robolab_sim/env/asset/textures/caution_yellow.png@ (
                    colorSpace = "sRGB"
                )
                float inputs:reflection_roughness_constant = 0.5
                token outputs:out (renderType = "material")
            }
        }
        def Material "MatZone"
        {
            token outputs:mdl:displacement.connect = </world/Task1Looks/MatZone/Shader.outputs:out>
            token outputs:mdl:surface.connect = </world/Task1Looks/MatZone/Shader.outputs:out>
            token outputs:mdl:volume.connect = </world/Task1Looks/MatZone/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.9, 0.88, 0.8)
                asset inputs:diffuse_texture = @/workspace/franka_robolab_sim/env/asset/textures/worker_zone.png@ (
                    colorSpace = "sRGB"
                )
                float inputs:reflection_roughness_constant = 0.7
                token outputs:out (renderType = "material")
            }
        }
    }


    # ── 작업자 구역 면 (시각 전용 Mesh) — Cube 는 UV 가 없어 텍스처가 안 붙는다.
    #    st 를 직접 넣은 사각 Mesh 로 만들고, 반복은 st 값을 1 위로 키워 처리한다.
    def Mesh "worker_zone" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </world/Task1Looks/MatZone>
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.45, -0.80, 0.0006), (1.05, -0.80, 0.0006), (1.05, -0.40, 0.0006), (-0.45, -0.40, 0.0006)]
        texCoord2f[] primvars:st = [(0, 0), (6, 0), (6, 1.6), (0, 1.6)] (
            interpolation = "faceVarying"
        )
        float3[] extent = [(-0.45, -0.80, 0), (1.05, -0.40, 0.001)]
        uniform token subdivisionScheme = "none"
    }

    # ── 경계 주의 테이프 50mm (시각 전용 Mesh) — 색을 바꾸려면 MatTape 의
    #    texture 를 caution_red.png 로 교체 ────────────────────────────────
    def Mesh "caution_tape" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </world/Task1Looks/MatTape>
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.45, -0.425, 0.0012), (1.05, -0.425, 0.0012), (1.05, -0.375, 0.0012), (-0.45, -0.375, 0.0012)]
        texCoord2f[] primvars:st = [(0, 0), (30, 0), (30, 1), (0, 1)] (
            interpolation = "faceVarying"
        )
        float3[] extent = [(-0.45, -0.425, 0), (1.05, -0.375, 0.002)]
        uniform token subdivisionScheme = "none"
    }

    # ── 배경 소품 3점 (2D 도면 승인 배치) — 파지 대상이 아니고 env 에 등록하지
    #    않으므로 리셋되지 않는다. 바닥 원점(제리캔·저그)은 z=0.002, 중심 원점(KLT)은
    #    z=반높이+0.002 로 표면 위 2mm 에서 시작해 기동 시 바로 안착한다. ──────────
    def "prop_klt" (
        prepend payload = @https://omniverse-content-production.s3.us-west-2.amazonaws.com/Assets/Isaac/5.1/Isaac/Props/KLT_Bin/small_KLT.usd@
    )
    {
        quatf xformOp:orient = (0.7071068, 0, 0, 0.7071068)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.88, 0.55, 0.0752)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
    def "prop_jerrican" (
        prepend payload = @/workspace/robolab/assets/objects/vomp/plasticjerrican_a01/plasticjerrican_a01.usd@
    )
    {
        quatf xformOp:orient = (0.98481, 0, 0, 0.17365)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.10, 0.58, 0.002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
    def "prop_jug" (
        prepend payload = @/workspace/robolab/assets/objects/vomp/utilityjug_a01/utilityjug_a01.usd@
    )
    {
        quatf xformOp:orient = (0.9563, 0, 0, -0.25882)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.25, 0.5, 0.002)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    # ── 공구 3점 — 안착 자세 굽기 완료. 자세는 robolab tools_sorting.usda 의 물리 안착값 ──────
    def "hammer_7" (
        prepend payload = @../objects/tools/hammer_7/hammer_7.usd@
    )
    {
        quatf xformOp:orient = (0.99999, 0.00198, 0.00357, 8e-05)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.5301, 0.1, 0.019)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        # 파지 지점 표시 — 정책이 잡을 곳을 눈으로 찾도록 (시각 전용, 충돌 없음).
        # 위치·반지름은 메시 실측: 손잡이 축은 로컬 +X, 반지름 21.6mm.
        def Cylinder "grip_band" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </world/Task1Looks/MatGripBand> (
                bindMaterialAs = "strongerThanDescendants"
            )
            uniform token axis = "X"
            double radius = 0.03
            double height = 0.025
            color3f[] primvars:displayColor = [(0.95, 0.8, 0.05)]
            double3 xformOp:translate = (0, 0, -0.008)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

    }
    def "cordless_drill" (
        prepend payload = @../objects/tools/cordless_drill/cordless_drill.usd@
        prepend apiSchemas = ["PhysicsMassAPI"]
    )
    {
        # 무게중심을 손잡이 파지점(정점 슬라이스로 잰 좁은 구간의 중앙)에 고정 —
        # 2지 그리퍼가 정확히 CoM 을 물게 되어 운반·회전 중 기울어질 토크가 없다.
        # 좌표는 드릴 로컬(굽힌 자세 월드 오프셋 (-0.03,-0.035,-0.007)을 역회전).
        point3f physics:centerOfMass = (0.0402, -0.0225, -0.007)
        quatf xformOp:orient = (-0.63338, 0.001, 0.00047, 0.77384)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.55, 0.2601, 0.0308)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Cube "counterweight"
        {
            # 배터리팩 하부에 붙인 균형추(시각 표현). 물리 효과는 위의
            # physics:centerOfMass 가 담당하므로 콜라이더는 두지 않는다.
            color3f[] primvars:displayColor = [(0.12, 0.12, 0.12)]
            double size = 1
            double3 xformOp:translate = (0.0148, -0.0735, 0)
            float3 xformOp:scale = (0.04, 0.03, 0.02)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        # 파지 지점 표시 (시각 전용). 손잡이 축은 로컬 -Y(기울기 10° 내), 반지름 23.1mm.
        # 위치는 파지점 = 무게중심으로 잡아 둔 지점과 같다.
        def Cylinder "grip_band" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </world/Task1Looks/MatGripBand> (
                bindMaterialAs = "strongerThanDescendants"
            )
            uniform token axis = "Y"
            double radius = 0.0265
            double height = 0.025
            color3f[] primvars:displayColor = [(0.95, 0.8, 0.05)]
            double3 xformOp:translate = (0.0402, -0.0225, -0.007)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

    }
}
