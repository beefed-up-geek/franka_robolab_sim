    # ── 씌우는형 단자 커넥터 2종 (파지 대상, T-그립 X축 평행) ────────────
    def "connector_red" (
        prepend references = @../objects/task2/connector_red.usda@
    )
    {
        rel material:binding:physics = </world/PhysicsMaterial>
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.28, 0.22, 0.0005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
    def "connector_black" (
        prepend references = @../objects/task2/connector_black.usda@
    )
    {
        rel material:binding:physics = </world/PhysicsMaterial>
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.44, 0.2, 0.0005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    # ── test 전용: 작업자 팔 — 강체 침입 장애물, runner 의 ArmIntruder 가
    #    매 스텝 자세를 기록해 구동한다. 파킹 = 절단된 앞모서리(x 0.65) 밖에서
    #    팔 내림(Y축 -90°). 진입은 앞뒤(x축) 수평 (사용자 지정).
    def "worker_arm" (
        prepend references = @../objects/task2/worker_arm.usda@
    )
    {
        quatf xformOp:orient = (0.7071068, 0, -0.7071068, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.78, -0.45, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    # ── task2 전용: 남는 상판을 잘라낸다 (_can_workcell 원본 불변) ──────
    over "table"
    {
        double3 xformOp:translate = (0.1, 0, -0.35)
        float3 xformOp:scale = (1.571428, 1.6, 1)
    }
}
