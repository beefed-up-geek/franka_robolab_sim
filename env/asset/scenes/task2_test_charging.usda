#usda 1.0
(
    doc = """task2 test 씬 — 배치는 train 과 완전히 동일하고, 작업자 팔
    (worker_arm)만 추가된다. 운반 중 팔이 작업 영역에 들어왔다 나가는
    동적 방해 조건 하나만으로 train 대비 성능을 1:1 비교한다.

    고정 설비는 task1/task3 과 같은 _can_workcell.usda(작업대·바닥) 서브레이어.
    워크스페이스 매트도 task1 과 동일 (x 0.35~0.75, y -0.35~0.35, 3mm 콜라이더).

    배치 (기본 behind 뷰 기준 화면 오른쪽 = -y):
      배터리(SAM3D, H5 실측 0.242m, z180° 반전)  (0.36, -0.48)  — 발전기와 ~1.0m, 삽입자세 도달 0.75
      발전기(SAM3D, 장축 0.40m, z+90°)           (0.55, +0.50)  — 화면 왼쪽
      중심 간 거리 0.92m — 배터리는 Franka 도달권 안, 발전기는 밖(고정 소품).
    전선·플러그·안착 판정은 다음 단계에서 붙는다.
    """
    subLayers = [
        @./_can_workcell.usda@
    ]
    defaultPrim = "world"
    metersPerUnit = 1
    upAxis = "Z"
)

over "world"
{
    def Scope "Task2Looks"
    {
        def Material "MatWhite"
        {
            token outputs:mdl:displacement.connect = </world/Task2Looks/MatWhite/Shader.outputs:out>
            token outputs:mdl:surface.connect = </world/Task2Looks/MatWhite/Shader.outputs:out>
            token outputs:mdl:volume.connect = </world/Task2Looks/MatWhite/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.93, 0.93, 0.90)
                float inputs:reflection_roughness_constant = 0.6
                token outputs:out (renderType = "material")
            }
        }
    }


    # ── SAM3D 복원 기물 ────────────────────────────────────────────────
    # 배터리는 강체 — 씬에 강체가 하나도 없으면 접촉 센서 활성화가 실패하고
    # (robolab schemas 검사), 다음 단계의 단자 안착 판정에도 어차피 필요하다.
    def "battery" (
        prepend references = @../objects/task2/sam3d_battery.usda@
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 15.0
        quatf xformOp:orient = (0, 0, 0, 1)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.36, -0.48, 0.0005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "mesh" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
        )
        {
            uniform token physics:approximation = "convexHull"
        }

        # 단자 연장 포스트 (실물의 terminal extender) — SAM3D 메시의 단자가
        # 리세스 속에 있어 소켓이 물리적으로 씌워질 수 없으므로, 단자 위치에
        # 단자 실측 중심에 황동색 연장 포스트(r9.5mm, 단자와 동색)를 세워 뚜껑 위 2cm 돌출시킨다. 부착 목표 = 이 상단.
        def Cylinder "post_ext_pos" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double radius = 0.0095
            double height = 0.05
            color3f[] primvars:displayColor = [(0.61, 0.54, 0.31)]
            double3 xformOp:translate = (0.0962, -0.0546, 0.185)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cylinder "post_ext_pos_ring" 
        {
            uniform token axis = "Z"
            double radius = 0.0095
            double height = 0.006
            color3f[] primvars:displayColor = [(0.8, 0.12, 0.09)]
            double3 xformOp:translate = (0.0962, -0.0546, 0.166)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cylinder "post_ext_neg" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            double radius = 0.0095
            double height = 0.05
            color3f[] primvars:displayColor = [(0.61, 0.54, 0.31)]
            double3 xformOp:translate = (-0.0962, -0.0523, 0.185)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cylinder "post_ext_neg_ring"
        {
            uniform token axis = "Z"
            double radius = 0.0095
            double height = 0.006
            color3f[] primvars:displayColor = [(0.1, 0.25, 0.6)]
            double3 xformOp:translate = (-0.0962, -0.0523, 0.166)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
    def "generator" (
        prepend references = @../objects/task2/sam3d_generator.usda@
    )
    {
        quatf xformOp:orient = (0.7071068, 0, 0, 0.7071068)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.36, 0.5, 0.0005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }










    def Material "rope_phys_mat" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:staticFriction = 0.05
        float physics:dynamicFriction = 0.05
        float physics:restitution = 0.0
    }
    # ── DC 충전 전선 — 물리 정착 곡선을 구운 **고정 튜브 메시** (시각 전용).
    #    소켓 면에서 나와 상판 위로만 늘어져 커넥터 인입부에 시각적으로 닿는다.
    #    커넥터를 옮겨도 전선은 남는다 (관절 로프는 혼란이 커 되돌림 — 사용자 결정).
    def Cylinder "dc_socket"
    {
        uniform token axis = "Y"
        double radius = 0.03
        double height = 0.05
        color3f[] primvars:displayColor = [(0.55, 0.56, 0.58)]
        double3 xformOp:translate = (0.31, 0.372, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cylinder "dc_socket_face"
    {
        uniform token axis = "Y"
        double radius = 0.022
        double height = 0.006
        color3f[] primvars:displayColor = [(0.35, 0.36, 0.38)]
        double3 xformOp:translate = (0.31, 0.3455, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Mesh "wire_red"
    {
        float3[] extent = [(-0.2, -0.9, -0.05), (1.1, 0.9, 0.7)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [0, 1, 11, 10, 1, 2, 12, 11, 2, 3, 13, 12, 3, 4, 14, 13, 4, 5, 15, 14, 5, 6, 16, 15, 6, 7, 17, 16, 7, 8, 18, 17, 8, 9, 19, 18, 9, 0, 10, 19, 10, 11, 21, 20, 11, 12, 22, 21, 12, 13, 23, 22, 13, 14, 24, 23, 14, 15, 25, 24, 15, 16, 26, 25, 16, 17, 27, 26, 17, 18, 28, 27, 18, 19, 29, 28, 19, 10, 20, 29, 20, 21, 31, 30, 21, 22, 32, 31, 22, 23, 33, 32, 23, 24, 34, 33, 24, 25, 35, 34, 25, 26, 36, 35, 26, 27, 37, 36, 27, 28, 38, 37, 28, 29, 39, 38, 29, 20, 30, 39, 30, 31, 41, 40, 31, 32, 42, 41, 32, 33, 43, 42, 33, 34, 44, 43, 34, 35, 45, 44, 35, 36, 46, 45, 36, 37, 47, 46, 37, 38, 48, 47, 38, 39, 49, 48, 39, 30, 40, 49, 40, 41, 51, 50, 41, 42, 52, 51, 42, 43, 53, 52, 43, 44, 54, 53, 44, 45, 55, 54, 45, 46, 56, 55, 46, 47, 57, 56, 47, 48, 58, 57, 48, 49, 59, 58, 49, 40, 50, 59, 50, 51, 61, 60, 51, 52, 62, 61, 52, 53, 63, 62, 53, 54, 64, 63, 54, 55, 65, 64, 55, 56, 66, 65, 56, 57, 67, 66, 57, 58, 68, 67, 58, 59, 69, 68, 59, 50, 60, 69, 60, 61, 71, 70, 61, 62, 72, 71, 62, 63, 73, 72, 63, 64, 74, 73, 64, 65, 75, 74, 65, 66, 76, 75, 66, 67, 77, 76, 67, 68, 78, 77, 68, 69, 79, 78, 69, 60, 70, 79, 70, 71, 81, 80, 71, 72, 82, 81, 72, 73, 83, 82, 73, 74, 84, 83, 74, 75, 85, 84, 75, 76, 86, 85, 76, 77, 87, 86, 77, 78, 88, 87, 78, 79, 89, 88, 79, 70, 80, 89, 80, 81, 91, 90, 81, 82, 92, 91, 82, 83, 93, 92, 83, 84, 94, 93, 84, 85, 95, 94, 85, 86, 96, 95, 86, 87, 97, 96, 87, 88, 98, 97, 88, 89, 99, 98, 89, 80, 90, 99, 90, 91, 101, 100, 91, 92, 102, 101, 92, 93, 103, 102, 93, 94, 104, 103, 94, 95, 105, 104, 95, 96, 106, 105, 96, 97, 107, 106, 97, 98, 108, 107, 98, 99, 109, 108, 99, 90, 100, 109, 100, 101, 111, 110, 101, 102, 112, 111, 102, 103, 113, 112, 103, 104, 114, 113, 104, 105, 115, 114, 105, 106, 116, 115, 106, 107, 117, 116, 107, 108, 118, 117, 108, 109, 119, 118, 109, 100, 110, 119, 110, 111, 121, 120, 111, 112, 122, 121, 112, 113, 123, 122, 113, 114, 124, 123, 114, 115, 125, 124, 115, 116, 126, 125, 116, 117, 127, 126, 117, 118, 128, 127, 118, 